+/// Polls every future until all are done (all run on the one nginx event loop, no threads).
+async fn join_all<T>(
+    mut futs: std::vec::Vec<core::pin::Pin<std::boxed::Box<dyn core::future::Future<Output = T> + '_>>>,
+) -> std::vec::Vec<T> {
+    use core::task::Poll;
+    let mut out: std::vec::Vec<Option<T>> = futs.iter().map(|_| None).collect();
+    core::future::poll_fn(|cx| {
+        let mut pending = false;
+        for (f, o) in futs.iter_mut().zip(out.iter_mut()) {
+            if o.is_none() {
+                match f.as_mut().poll(cx) {
+                    Poll::Ready(v) => *o = Some(v),
+                    Poll::Pending => pending = true,
                 }
             }
         }
+        if pending { Poll::Pending } else { Poll::Ready(()) }
+    })
+    .await;
+    out.into_iter().map(|o| o.unwrap()).collect()
+}
 
